# Copy to .env. Never commit real credentials.
OPENAI_API_KEY=
# Comma-separated SHA-256 hashes of Slide API keys allowed to use the hosted key.
# Empty disables hosted-key access; all other workspaces must bring their own key.
CHAT_HOSTED_SLIDE_KEY_HASHES=
# GPT-6 Astra is the application model; users can provide their own OpenAI key.
SECRET_KEY=
# Optional Fernet key; otherwise created once in the private instance directory.
CHAT_ENCRYPTION_KEY=
CHAT_DATA_DIR=/var/lib/slide-chat
CHAT_DAILY_WORKSPACE_REQUESTS=100
CHAT_DAILY_HOSTED_REQUESTS=200
FLASK_ENV=production
PORT=8882
